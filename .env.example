# Slack Bot credentials (from api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token

# Salesforce credentials
SF_LOGIN_URL=https://login.salesforce.com
SF_USERNAME=your@email.com
SF_PASSWORD=yourpassword
SF_SECURITY_TOKEN=yourSecurityToken
SF_CLIENT_ID=your_connected_app_client_id
SF_CLIENT_SECRET=your_connected_app_client_secret

# Constant Contact credentials
# Get these from developer.constantcontact.com
CC_API_KEY=your_api_key
CC_CLIENT_SECRET=your_client_secret
CC_ACCESS_TOKEN=your_oauth_access_token
CC_REFRESH_TOKEN=your_oauth_refresh_token
CC_DEFAULT_LIST_ID=your_list_id

# Server
PORT=3000
